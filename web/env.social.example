# Social content automation (add to .env.local)

# Vercel Cron auth — set same value in Vercel dashboard
CRON_SECRET=your-random-secret-here

# Gmail SMTP (App Password: Google Account → Security → 2FA → App passwords)
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_FROM=your@gmail.com

# Optional; falls back to GUEST_AUTH_SECRET
SOCIAL_APPROVAL_SECRET=your-random-secret-here

# ── Publish to Instagram & TikTok (test) ─────────────────────────────────────
# Must be a PUBLIC URL (Vercel preview/prod). localhost will NOT work — Meta/TikTok must fetch the image.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# TikTok Login Kit (OAuth) — from TikTok Developer Portal → Credentials
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# From OAuth connect flow (/admin/social → Connect TikTok) or manual token exchange
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY = only you see the post (good for testing). PUBLIC_TO_EVERYONE when ready.
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Instagram Graph API — Business/Creator account linked to a Facebook Page
# @momentiim.official ID from Meta Business Suite
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
